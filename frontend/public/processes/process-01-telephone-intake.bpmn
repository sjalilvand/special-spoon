<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Defs_Process_Telephone_Intake" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Rosepsy" exporterVersion="1">
  <bpmn:process id="Process_Telephone_Intake" name="فرایند پذیرش اولیه مراجعان تلفنی (RS-PS-01-01)" isExecutable="false">
    <bpmn:startEvent id="Start_01" name="تماس مراجع">
      <bpmn:outgoing>F101</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1_01" name="ثبت اطلاعات فردی مراجع
(RS-PS-01-01)">
      <bpmn:outgoing>F102</bpmn:outgoing>
      <bpmn:incoming>F101</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T2_01" name="ارزیابی اولیه موضوع مراجعه">
      <bpmn:outgoing>F103</bpmn:outgoing>
      <bpmn:incoming>F102</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1_01" name="مورد حاد/پرخطر؟" default="F104">
      <bpmn:outgoing>F104</bpmn:outgoing>
      <bpmn:outgoing>F105</bpmn:outgoing>
      <bpmn:incoming>F103</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3_01" name="فعال‌سازی فرایند مورد حاد
(RS-PS-08-01)">
      <bpmn:outgoing>F106</bpmn:outgoing>
      <bpmn:incoming>F104</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="End1_01" name="انتقال به فرایند مورد حاد">
      <bpmn:incoming>F106</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T4_01" name="تعیین مسیر مراجع
(حضوری / اطلاع‌رسانی / تماس مجدد)">
      <bpmn:outgoing>F107</bpmn:outgoing>
      <bpmn:incoming>F105</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T5_01" name="ثبت فرم پذیرش تلفنی">
      <bpmn:outgoing>F108</bpmn:outgoing>
      <bpmn:incoming>F107</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T6_01" name="بازبینی کارشناس نظارت حرفه‌ای">
      <bpmn:outgoing>F109</bpmn:outgoing>
      <bpmn:incoming>F108</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="End2_01" name="پایان تماس">
      <bpmn:incoming>F109</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F101" sourceRef="Start_01" targetRef="T1_01" />
    <bpmn:sequenceFlow id="F102" sourceRef="T1_01" targetRef="T2_01" />
    <bpmn:sequenceFlow id="F103" sourceRef="T2_01" targetRef="G1_01" />
    <bpmn:sequenceFlow id="F104" sourceRef="G1_01" targetRef="T3_01" name="بله" />
    <bpmn:sequenceFlow id="F105" sourceRef="G1_01" targetRef="T4_01" name="خیر" />
    <bpmn:sequenceFlow id="F106" sourceRef="T3_01" targetRef="End1_01" />
    <bpmn:sequenceFlow id="F107" sourceRef="T4_01" targetRef="T5_01" />
    <bpmn:sequenceFlow id="F108" sourceRef="T5_01" targetRef="T6_01" />
    <bpmn:sequenceFlow id="F109" sourceRef="T6_01" targetRef="End2_01" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_Telephone_Intake">
    <bpmndi:BPMNPlane id="Plane_Process_Telephone_Intake" bpmnElement="Process_Telephone_Intake">
      <bpmndi:BPMNShape id="Start_01_di" bpmnElement="Start_01">
