        <di:waypoint x="1020" y="108" />

      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F107_di" bpmnElement="F107">
        <di:waypoint x="960" y="308" />
        <di:waypoint x="1010" y="308" />

      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F108_di" bpmnElement="F108">
        <di:waypoint x="1160" y="308" />
        <di:waypoint x="1210" y="308" />

      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F109_di" bpmnElement="F109">
        <di:waypoint x="1380" y="308" />
        <di:waypoint x="1430" y="308" />

      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
