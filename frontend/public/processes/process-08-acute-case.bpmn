  <bpmn:process id="Process_Acute_Case" name="فرایند ارزیابی و مدیریت مورد حاد / پر خطر (RS-PS-08-01)" isExecutable="false">
    <bpmn:startEvent id="Start_08" name="شناسایی مورد حاد">
      <bpmn:outgoing>F301</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1_08" name="ثبت فرم RS-PS-08-01 و تعیین سطح فوریت">
      <bpmn:outgoing>F302</bpmn:outgoing>
      <bpmn:incoming>F301</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1_08" name="سطح فوریت؟" default="F303">
      <bpmn:outgoing>F303</bpmn:outgoing>
      <bpmn:outgoing>F304</bpmn:outgoing>
      <bpmn:outgoing>F305</bpmn:outgoing>
      <bpmn:incoming>F302</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2_08" name="سطح ۱ — پایش دوره‌ای و تماس پیگیری">
      <bpmn:outgoing>F306</bpmn:outgoing>
      <bpmn:incoming>F303</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T3_08" name="سطح ۲ — ارجاع برنامه‌ریزی‌شده به مرجع تخصصی">
      <bpmn:outgoing>F307</bpmn:outgoing>
      <bpmn:incoming>F304</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T4_08" name="سطح ۳ — اقدام فوری و ارجاع اورژانسی
(اورژانس اجتماعی / پزشکی)">
      <bpmn:outgoing>F308</bpmn:outgoing>
      <bpmn:incoming>F305</bpmn:incoming>
      <bpmn:incoming>F314</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T7_08" name="کارتابل هشدار سطح ۳ —
بررسی و تأیید مسئول فنی">
      <bpmn:outgoing>F314</bpmn:outgoing>
      <bpmn:outgoing>F315</bpmn:outgoing>
      <bpmn:incoming>F308</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2_08" name="ادغام مسیرها" default="F309">
      <bpmn:outgoing>F309</bpmn:outgoing>
      <bpmn:incoming>F306</bpmn:incoming>
      <bpmn:incoming>F307</bpmn:incoming>
      <bpmn:incoming>F315</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5_08" name="ثبت نتیجه تماس و پذیرش مقصد">
      <bpmn:outgoing>F310</bpmn:outgoing>
      <bpmn:incoming>F309</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T6_08" name="پیگیری توسط مسئول پیگیری">
      <bpmn:outgoing>F311</bpmn:outgoing>
      <bpmn:incoming>F310</bpmn:incoming>
      <bpmn:incoming>F313</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3_08" name="مورد حاد بسته می‌شود؟" default="F312">
      <bpmn:outgoing>F312</bpmn:outgoing>
      <bpmn:outgoing>F313</bpmn:outgoing>
      <bpmn:incoming>F311</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_08" name="مورد حاد مختومه شد">
      <bpmn:incoming>F312</bpmn:incoming>
    </bpmn:endEvent>
