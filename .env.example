# Rosepsy - تنظیمات محیط (بند ۱۳.۲: این فایل واقعی خارج از مخزن و با مجوز محدود نگهداری شود)
# این فایل را به .env کپی کنید و مقادیر را تغییر دهید

# --- PostgreSQL ---
POSTGRES_USER=rosepsy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rosepsy

# --- Backend (داخل شبکه Docker) ---
DATABASE_URL=postgresql+psycopg://rosepsy:CHANGE_ME_STRONG_PASSWORD@db:5432/rosepsy
ENVIRONMENT=production

# --- احراز هویت (فاز ۲ - بند ۴.۲ سند) ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
