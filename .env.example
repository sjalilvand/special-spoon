# Rosepsy - تنظیمات محیط (بند ۱۳.۲: فایل واقعی خارج از مخزن و با مجوز محدود)
# این فایل را به .env کپی کنید و مقادیر CHANGE_ME را تصادفی کنید

# --- PostgreSQL ---
POSTGRES_USER=rosepsy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rosepsy

# --- Backend ---
DATABASE_URL=postgresql+psycopg://rosepsy:CHANGE_ME_STRONG_PASSWORD@db:5432/rosepsy
# development فقط برای تست محلی HTTP؛ در عملیات: production (نیازمند HTTPS)
ENVIRONMENT=development

# کلید امضای Access Token - حتماً تصادفی (مثال تولید: openssl rand -hex 32)
AUTH_SECRET_KEY=CHANGE_ME_RANDOM_HEX64

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ACTIVATION_TOKEN_EXPIRE_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# --- فاز ۲۷ - B39-plus: آنتی‌ویروس واقعی (ClamAV) ---
# در docker compose مقدار CLAMAV_HOST=clamav است؛ نصب بومی: خالی بگذارید تا از قواعد پایه استفاده شود
CLAMAV_ENABLED=true
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
STRIP_IMAGE_METADATA=true

# --- فاز ۲۷ - B12+: خروجی اعلان به ایمیل (تصمیم D04 - SMTP) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=rosepsy@clinic.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATIONS_EMAIL_ENABLED=true

# --- فاز ۲۹ - B10/B11: سفارش و پرداخت (تصمیم D02: درگاه پلاگین‌پذیر) ---
# sandbox = شبیه‌ساز توسعه/آزمون؛ zarinpal = درگاه پیشنهادی تولید
PAYMENT_GATEWAY=sandbox
# آدرس عمومی سامانه برای ساخت callback درگاه واقعی
PUBLIC_BASE_URL=http://localhost:5173
# زرین‌پال REST v4؛ خالی بودن merchant یعنی درگاه غیرفعال
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# --- فاز ۳۶ - B28: یکپارچه‌سازی‌های بیرونی — سرویس پیامک پلاگین‌پذیر ---
# log = توسعه/آزمون بدون کلید؛ kavenegar/smsir فقط با کلید (نبود کلید → fallback به log)
SMS_ENABLED=false
SMS_PROVIDER=log
# کلید سرویس پیامک؛ هرگز به کلاینت/لاگ نمی‌رود
SMS_API_KEY=
SMS_SENDER=
SMS_MAX_ATTEMPTS=5
# کپی اعلان‌های درون‌برنامه‌ای به پیامک (فقط گیرنده دارای موبایل)
NOTIFICATIONS_SMS_ENABLED=true
