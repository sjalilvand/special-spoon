# Rosepsy - تنظیمات محیط (بند ۱۳.۲: فایل واقعی خارج از مخزن و با مجوز محدود)
# این فایل را به .env کپی کنید و مقادیر CHANGE_ME را تصادفی کنید

# --- PostgreSQL ---
POSTGRES_USER=rosepsy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rosepsy

# --- Backend ---
DATABASE_URL=postgresql+psycopg://rosepsy:CHANGE_ME_STRONG_PASSWORD@db:5432/rosepsy
# development فقط برای تست محلی HTTP؛ در عملیات: production (نیازمند HTTPS)
ENVIRONMENT=development

# کلید امضای Access Token - حتماً تصادفی (مثال تولید: openssl rand -hex 32)
AUTH_SECRET_KEY=CHANGE_ME_RANDOM_HEX64

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ACTIVATION_TOKEN_EXPIRE_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
