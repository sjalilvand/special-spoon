                  id="Defs_Process_Rosepsy_Overall" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Rosepsy" exporterVersion="1">
  <bpmn:process id="Process_Rosepsy_Overall" name="گردش کلی خدمات مشاوره روان‌شناختی سازمانی" isExecutable="false">
    <bpmn:startEvent id="Start_00" name="مراجع (تلفن / سایت عمومی / حضوری)">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1_00" name="پاسخگویی و ثبت درخواست">
      <bpmn:outgoing>F02</bpmn:outgoing>
      <bpmn:incoming>F01</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T2_00" name="پذیرش اولیه تلفنی
(RS-PS-01-01)">
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:incoming>F02</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1_00" name="مورد حاد/پرخطر؟" default="F04">
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:incoming>F03</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3_00" name="مدیریت مورد حاد
(RS-PS-08-01)">
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:incoming>F04</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T4_00" name="پیگیری مورد حاد و مختومه‌سازی">
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:incoming>F06</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="End1_00" name="مورد حاد مختومه شد">
      <bpmn:incoming>F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T5_00" name="پذیرش حضوری، تشکیل پرونده و رضایت
(RS-PS-04-01)">
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T6_00" name="تخصیص مشاور">
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:incoming>F08</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T7_00" name="ارزیابی تخصصی، MSE و طرح درمان
(RS-PS-04-01)">
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:incoming>F09</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T8_00" name="تأیید مسئول فنی">
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T9_00" name="جلسات درمانی و نوبت‌دهی">
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2_00" name="تکمیل اهداف درمان؟" default="F13">
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T10_00" name="ارزیابی پایانی و بستن پرونده">
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="End2_00" name="پرونده بسته شد">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
