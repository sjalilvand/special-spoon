  <bpmn:process id="Process_Case_Intake" name="فرایند پذیرش و تشکیل پرونده (RS-PS-04-01)" isExecutable="false">
    <bpmn:startEvent id="Start_04" name="مراجعه حضوری / درخواست مشاوره">
      <bpmn:outgoing>F201</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1_04" name="ثبت اطلاعات و تشکیل پرونده">
      <bpmn:outgoing>F202</bpmn:outgoing>
      <bpmn:incoming>F201</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T2_04" name="تکمیل رضایت‌نامه آگاهانه">
      <bpmn:outgoing>F203</bpmn:outgoing>
      <bpmn:incoming>F202</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T3_04" name="تخصیص مشاور">
      <bpmn:outgoing>F204</bpmn:outgoing>
      <bpmn:incoming>F203</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T4_04" name="ارزیابی تخصصی و MSE
(فرم RS-PS-04-01)">
      <bpmn:outgoing>F205</bpmn:outgoing>
      <bpmn:incoming>F204</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T5_04" name="نهایی‌سازی توسط مشاور">
      <bpmn:outgoing>F206</bpmn:outgoing>
      <bpmn:incoming>F205</bpmn:incoming>
      <bpmn:incoming>F209</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1_04" name="تأیید مسئول فنی؟" default="F207">
      <bpmn:outgoing>F207</bpmn:outgoing>
      <bpmn:outgoing>F208</bpmn:outgoing>
      <bpmn:incoming>F206</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T6_04" name="اصلاح توسط مشاور
(نسخه اصلاحی)">
      <bpmn:outgoing>F209</bpmn:outgoing>
      <bpmn:incoming>F208</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T7_04" name="تدوین طرح درمان">
      <bpmn:outgoing>F210</bpmn:outgoing>
      <bpmn:incoming>F207</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T8_04" name="جلسات درمانی و نوبت‌دهی">
      <bpmn:outgoing>F211</bpmn:outgoing>
      <bpmn:incoming>F210</bpmn:incoming>
      <bpmn:incoming>F212</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2_04" name="پاسخ به درمان؟" default="F212">
      <bpmn:outgoing>F212</bpmn:outgoing>
      <bpmn:outgoing>F213</bpmn:outgoing>
      <bpmn:incoming>F211</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T9_04" name="ارزیابی پایانی و بستن پرونده">
      <bpmn:outgoing>F214</bpmn:outgoing>
      <bpmn:incoming>F213</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="End_04" name="پرونده بسته شد">
      <bpmn:incoming>F214</bpmn:incoming>
    </bpmn:endEvent>
